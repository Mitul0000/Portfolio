# ===== Server =====
PORT=3000

# ===== Database =====
# Local:  mongodb://127.0.0.1:27017/portfolio
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio
MONGO_URI=

# ===== JWT secrets (use long random strings, all three must be DIFFERENT) =====
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
REFRESH_SECRET=
FORGOT_SECRET=

# ===== Email (Gmail SMTP via Nodemailer) =====
# EMAIL_PASS must be a Gmail App Password (Google Account > Security > 2-Step Verification > App passwords),
# NOT your normal Gmail password.
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=
# Receives the "New Tool Requested" notification emails
ADMIN_EMAIL=admin@example.com

# ===== App =====
# Shown as the sender name and inside email templates
APP_NAME=Digifello AI
# Frontend base URL, used for password reset links (no trailing slash)
FRONTEND_URL=http://localhost:5173